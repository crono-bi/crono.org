---
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitleHref } = Astro.locals.starlightRoute;

const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/^\/en(?=\/|$)/, '');

let siteTitle = 'Manual de usuario';
let productLogoSrc: string | null = null;
let productName = '';

if (normalizedPath.startsWith('/analysis/')) {
	siteTitle = 'Manual Crono Analysis';
	productLogoSrc = '/logos/crono-analysis.webp';
	productName = 'Crono Analysis';
} else if (normalizedPath.startsWith('/metadata/')) {
	siteTitle = 'Manual Crono Metadata';
	productLogoSrc = '/logos/crono-metadata.webp';
	productName = 'Crono Metadata';
} else if (normalizedPath.startsWith('/etl/')) {
	siteTitle = 'Manual Crono ETL';
	productLogoSrc = '/logos/crono-etl.webp';
	productName = 'Crono ETL';
} else if (normalizedPath.startsWith('/sql/')) {
	siteTitle = 'Manual Crono SQL';
	productLogoSrc = '/logos/crono-sql.webp';
	productName = 'Crono SQL';
} else if (normalizedPath.startsWith('/playground')) {
	siteTitle = 'Crono Playground';
	productLogoSrc = '/logos/crono-playground.webp';
	productName = 'Crono Playground';
}
---

<script is:inline define:vars={{ section: normalizedPath.split('/')[1] }}>
  (function() {
    const brandClasses = ['brand-analysis', 'brand-metadata', 'brand-etl', 'brand-sql'];
    const html = document.documentElement;
    brandClasses.forEach(c => html.classList.remove(c));
    if (['analysis', 'metadata', 'etl', 'sql'].includes(section)) {
      html.classList.add('brand-' + section);
    }
  })();
</script>

<a href={siteTitleHref} class="site-title sl-flex">
	{productLogoSrc ? (
		<img src={productLogoSrc} alt={productName} class="product-logo" />
	) : (
		<img src="/logos/crono.webp" alt="Crono" class="main-logo" />
	)}
	<span class="sr-only" translate="no">
		{siteTitle}
	</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		span {
			overflow: hidden;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}
		/* Crono main logo */
		.main-logo {
			height: 28px;
			width: auto;
			filter: invert(0);
			transition: filter 0.2s;
		}

		/* Product logo */
		.product-logo {
			height: 28px;
			width: auto;
			max-width: none;
			object-fit: contain;
			object-position: left center;
			filter: invert(0);
			transition: filter 0.2s;
		}

		:root[data-theme='dark'] .product-logo,
		:root:not([data-theme='light']) .product-logo,
		:root[data-theme='dark'] .main-logo,
		:root:not([data-theme='light']) .main-logo {
			filter: invert(1);
		}
	}
</style>
