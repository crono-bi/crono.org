---
// Página de Precios - mismo estilo visual que DownloadsLanding
import { PRODUCTS } from '../config/products'
import { useT, getLangFromLocale } from '../i18n/ui'
import SupportBanner from './SupportBanner.astro'

const t = useT(getLangFromLocale(Astro.currentLocale))

interface Tier {
  name: string
  tagline: string
  price: string
  priceDetail?: string
  description: string
  cta: string
  ctaHref: string
  highlight?: boolean
  freeForever?: boolean
  contact?: boolean
}

interface Section {
  title: string
  color: string
  rgb: string
  icon: string
  tiers: Tier[]
}

const sections: Section[] = [
  {
    title: t('pricingLanding.section.etl.title'),
    color: PRODUCTS.etl.color,
    rgb: PRODUCTS.etl.rgb,
    icon: PRODUCTS.etl.icon,
    tiers: [
      {
        name: t('pricingLanding.tier.etlCli.name'),
        tagline: t('pricingLanding.tier.etlCli.tagline'),
        price: t('pricingLanding.tier.etlCli.price'),
        description: t('pricingLanding.tier.etlCli.desc'),
        cta: t('pricingLanding.tier.etlCli.cta'),
        ctaHref: '/downloads/crono-etl/',
        freeForever: true,
      },
      {
        name: t('pricingLanding.tier.etlTrial.name'),
        tagline: t('pricingLanding.tier.etlTrial.tagline'),
        price: t('pricingLanding.tier.etlTrial.price'),
        description: t('pricingLanding.tier.etlTrial.desc'),
        cta: t('pricingLanding.tier.etlTrial.cta'),
        ctaHref: '/downloads/crono-etl/',
      },
      {
        name: t('pricingLanding.tier.etlFull.name'),
        tagline: t('pricingLanding.tier.etlFull.tagline'),
        price: t('pricingLanding.tier.etlFull.price'),
        priceDetail: t('pricingLanding.tier.etlFull.priceDetail'),
        description: t('pricingLanding.tier.etlFull.desc'),
        cta: t('pricingLanding.tier.etlFull.cta'),
        ctaHref: '#',
        highlight: true,
        contact: true,
      },
    ]
  },
  {
    title: t('pricingLanding.section.analysis.title'),
    color: PRODUCTS.analysis.color,
    rgb: PRODUCTS.analysis.rgb,
    icon: PRODUCTS.analysis.icon,
    tiers: [
      {
        name: t('pricingLanding.tier.analysisTrial.name'),
        tagline: t('pricingLanding.tier.analysisTrial.tagline'),
        price: t('pricingLanding.tier.analysisTrial.price'),
        description: t('pricingLanding.tier.analysisTrial.desc'),
        cta: t('pricingLanding.tier.analysisTrial.cta'),
        ctaHref: '/downloads/crono-analysis/',
      },
      {
        name: t('pricingLanding.tier.analysisFull.name'),
        tagline: t('pricingLanding.tier.analysisFull.tagline'),
        price: t('pricingLanding.tier.analysisFull.price'),
        priceDetail: t('pricingLanding.tier.analysisFull.priceDetail'),
        description: t('pricingLanding.tier.analysisFull.desc'),
        cta: t('pricingLanding.tier.analysisFull.cta'),
        ctaHref: '#',
        highlight: true,
        contact: true,
      },
    ]
  },
  {
    title: t('pricingLanding.section.enterprise.title'),
    color: '#5B2C7D',
    rgb: '91, 44, 125',
    icon: PRODUCTS.metadata.icon,
    tiers: [
      {
        name: t('pricingLanding.tier.api.name'),
        tagline: t('pricingLanding.tier.api.tagline'),
        price: t('pricingLanding.tier.api.price'),
        priceDetail: t('pricingLanding.tier.api.priceDetail'),
        description: t('pricingLanding.tier.api.desc'),
        cta: t('pricingLanding.tier.api.cta'),
        ctaHref: '#',
        contact: true,
      },
      {
        name: t('pricingLanding.tier.server.name'),
        tagline: t('pricingLanding.tier.server.tagline'),
        price: t('pricingLanding.tier.server.price'),
        priceDetail: t('pricingLanding.tier.server.priceDetail'),
        description: t('pricingLanding.tier.server.desc'),
        cta: t('pricingLanding.tier.server.cta'),
        ctaHref: '#',
        contact: true,
      },
      {
        name: t('pricingLanding.tier.enterprise.name'),
        tagline: t('pricingLanding.tier.enterprise.tagline'),
        price: t('pricingLanding.tier.enterprise.price'),
        priceDetail: t('pricingLanding.tier.enterprise.priceDetail'),
        description: t('pricingLanding.tier.enterprise.desc'),
        cta: t('pricingLanding.tier.enterprise.cta'),
        ctaHref: '#',
        highlight: true,
        contact: true,
      },
    ]
  },
]
---

<div class="pr-landing not-content">

  <!-- Hero Global: Acceso de Por Vida -->
  <div class="pr-page-hero">
    <h1 class="pr-page-hero-title">{t('pricingLanding.lifetimeHero.title')}</h1>
    <p class="pr-page-hero-desc">{t('pricingLanding.lifetimeHero.desc')}</p>
  </div>

  {sections.map(section => (
    <div class="pr-section">
      <!-- Cabecera de sección -->
      <div class="pr-section-head" style={`--c: ${section.color}`}>
        <div class="pr-section-icon" set:html={section.icon} />
        <h2 class="pr-section-title">{section.title}</h2>
      </div>

      <!-- Grid de tarjetas -->
      <div class="pr-grid">
        {section.tiers.map(tier => (
          <div class={`pr-card${tier.highlight ? ' pr-card--hl' : ''}`} style={`--c: ${section.color}; --rgb: ${section.rgb}`}>
            <!-- Top: tagline -->
            <div class="pr-card-top">
              <span class="pr-card-tagline">{tier.tagline}</span>
              {tier.highlight && <span class="pr-badge">{t('pricingLanding.badge.recommended')}</span>}
            </div>
            <!-- Body -->
            <div class="pr-card-body">
              <h3 class="pr-card-name">{tier.name}</h3>
              <div class="pr-card-price">
                <span class="pr-price-value">{tier.freeForever ? t('pricingLanding.tier.etlTrial.freeForever') : tier.price}</span>
                {!tier.freeForever && tier.priceDetail && <span class="pr-price-detail">{tier.priceDetail}</span>}
              </div>
              <p class="pr-card-desc">{tier.description}</p>
            </div>
            <!-- Foot: CTA -->
            {!tier.contact && (
              <div class="pr-card-foot">
                <a href={tier.ctaHref} class={`pr-btn${tier.highlight ? ' pr-btn--primary' : ' pr-btn--secondary'}`}>
                  {tier.cta}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  ))}

  <!-- Garantía de Devolución -->
  <div class="pr-guarantee">
    <div class="pr-guarantee-header">
      <svg class="pr-guarantee-shield" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
      <h3 class="pr-guarantee-title">{t('pricingLanding.guarantee.title')}</h3>
    </div>
    <div class="pr-guarantee-divider"></div>
    <p class="pr-guarantee-highlight">{t('pricingLanding.guarantee.highlight')}</p>
    <div class="pr-guarantee-body">
      <p>{t('pricingLanding.guarantee.p1')}</p>
      <p>{t('pricingLanding.guarantee.p2')}</p>
      <p class="pr-guarantee-cta">{t('pricingLanding.guarantee.cta')}</p>
    </div>
    <div class="pr-guarantee-footer">
      <img src="/images/team/ceo-avatar.jpg" alt="CEO" class="pr-guarantee-avatar" width="48" height="48" />
      <div class="pr-guarantee-author">
        <span class="pr-guarantee-name">{t('pricingLanding.guarantee.author.name')}</span>
        <span class="pr-guarantee-role">{t('pricingLanding.guarantee.author.role')}</span>
      </div>
    </div>
  </div>

  <!-- Contacto único -->
  <div class="pr-contact">
    <h3 class="pr-contact-title">{t('pricingLanding.contact.title')}</h3>
    <p class="pr-contact-desc">{t('pricingLanding.contact.desc')}</p>
    <a href={`mailto:${t('pricingLanding.contact.email')}`} class="pr-contact-btn">
      {t('pricingLanding.contact.email')}
    </a>
  </div>

</div>

<SupportBanner />

<style>
  .pr-landing {
    padding: 0.25rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ── SECCIÓN ── */
  .pr-section-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-left: 0.25rem;
  }

  .pr-section-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--c);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    vertical-align: baseline;
  }

  .pr-section-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .pr-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--c);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  /* ── GRID ── */
  .pr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  /* ── TARJETA ── */
  .pr-card {
    display: flex;
    flex-direction: column;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    padding: 1.25rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .pr-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(var(--rgb), 0.06) 0%, transparent 55%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .pr-card:hover {
    border-color: var(--c);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -6px rgba(var(--rgb), 0.2);
  }

  .pr-card:hover::before { opacity: 1; }

  .pr-card--hl {
    border-color: var(--c);
  }

  .pr-card--hl::before { opacity: 1; }

  /* Top */
  .pr-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .pr-card-tagline {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--c);
  }

  .pr-badge {
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--c);
    color: white;
    flex-shrink: 0;
  }

  .pr-badge--free {
    background: #1B8AC7;
  }

  /* Body */
  .pr-card-body { flex: 1; }

  .pr-card-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 0.625rem;
    line-height: 1.25;
  }

  .pr-card-price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .pr-price-value {
    font-size: 1.625rem;
    font-weight: 800;
    color: var(--c);
    line-height: 1;
  }

  .pr-price-detail {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .pr-card-desc {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
    line-height: 1.55;
    margin: 0 0 1rem;
  }

  /* Foot */
  .pr-card-foot {
    margin-top: auto;
    padding-top: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .pr-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s;
  }

  .pr-btn--primary {
    background: var(--c);
    color: white;
  }

  .pr-btn--primary:hover {
    filter: brightness(1.1);
    box-shadow: 0 3px 10px rgba(var(--rgb), 0.35);
  }

  .pr-btn--secondary {
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
  }

  .pr-btn--secondary:hover {
    border-color: var(--c);
    color: var(--c);
  }

  /* Contacto único */
  .pr-contact {
    text-align: center;
    padding: 2rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    margin-top: 1rem;
  }

  .pr-contact-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 0.5rem;
  }

  .pr-contact-desc {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 1.25rem;
  }

  .pr-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: #1B8AC7;
    color: white;
    font-weight: 600;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s;
  }

  .pr-contact-btn:hover {
    filter: brightness(1.1);
    box-shadow: 0 4px 12px rgba(27, 138, 199, 0.35);
  }

  /* Hero Global: Acceso de Por Vida */
  .pr-page-hero {
    padding: 2.5rem 2.5rem;
    margin-bottom: 2rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    border-left: 3px solid #3B82F6;
    position: relative;
  }
  .pr-page-hero-title {
    font-size: 1.875rem;
    font-weight: 800;
    color: var(--sl-color-white);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .pr-page-hero-desc {
    font-size: 0.9375rem;
    color: var(--sl-color-gray-3);
    line-height: 1.7;
    max-width: 740px;
    margin: 0;
  }

  /* Garantía de Devolución */
  .pr-guarantee {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-top: 3px solid #F59E0B;
    border-radius: 8px;
    padding: 0;
    margin-top: 2rem;
    overflow: hidden;
  }
  .pr-guarantee-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1.5rem 2rem;
    background: rgba(245, 158, 11, 0.06);
    border-bottom: 1px solid rgba(245, 158, 11, 0.15);
  }
  .pr-guarantee-shield {
    color: #F59E0B;
    flex-shrink: 0;
    display: block;
  }
  .pr-guarantee-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1;
    display: flex;
    align-items: center;
  }
  .pr-guarantee-divider {
    display: none;
  }
  .pr-guarantee-highlight {
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 1.25rem;
    line-height: 1.65;
    padding: 1.5rem 2rem 0;
  }
  .pr-guarantee-body {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
    line-height: 1.75;
    padding: 0 2rem;
    margin-bottom: 0;
  }
  .pr-guarantee-body p {
    margin: 0 0 0.75rem;
  }
  .pr-guarantee-body p:last-child {
    margin-bottom: 0;
  }
  .pr-guarantee-cta {
    font-style: italic;
    color: var(--sl-color-gray-2);
  }
  .pr-guarantee-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 2rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .pr-guarantee-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .pr-guarantee-author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .pr-guarantee-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .pr-guarantee-role {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 640px) {
    .pr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
