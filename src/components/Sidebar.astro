---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import PlaygroundSidebar from '../playground/components/PlaygroundSidebar.vue';
import SidebarTopics from './SidebarTopics.astro';
import { useT, getLangFromLocale } from '../i18n/ui';

const isPlayground = /^\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?playground(?:\/|$)/i.test(Astro.url.pathname);
const topics = Astro.locals.starlightSidebarTopics?.topics ?? []

const lang = getLangFromLocale(Astro.currentLocale);
const t = useT(lang);
const prefix = lang === 'en' ? '/en' : '';
const homeHref = `${prefix}/`;
const downloadsHref = `${prefix}/downloads/`;
const pricingHref = `${prefix}/precios/`;
const downloadsLabel = lang === 'en' ? 'Downloads' : 'Descargas';
const pricingLabel = lang === 'en' ? 'Pricing' : 'Precios';
---

<!-- CTA al Inicio + nav principal (los links extra solo en móvil, donde el drawer sustituye al menú del header) -->
<div class="sidebar-cta-container">
	<a href={homeHref} class="sidebar-home-cta">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
			<polyline points="9 22 9 12 15 12 15 22"/>
		</svg>
		<span>{t('sidebar.home')}</span>
	</a>
	<a href={downloadsHref} class="sidebar-home-cta sidebar-nav-extra">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
			<polyline points="7 10 12 15 17 10"/>
			<line x1="12" y1="15" x2="12" y2="3"/>
		</svg>
		<span>{downloadsLabel}</span>
	</a>
	<a href={pricingHref} class="sidebar-home-cta sidebar-nav-extra">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
			<line x1="7" y1="7" x2="7.01" y2="7"/>
		</svg>
		<span>{pricingLabel}</span>
	</a>
</div>

{isPlayground ? (
	<div class="sidebar-playground-container">
		<PlaygroundSidebar client:only="vue" />
	</div>
) : (
	<>
		{topics.length > 0 && <SidebarTopics />}
		<Default><slot /></Default>
	</>
)}

<style>
	.sidebar-cta-container {
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--sl-color-gray-6);
	}

	.sidebar-home-cta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--sl-text-base);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		padding: 0.25rem var(--sl-sidebar-pad-x);
		border-radius: 6px;
		transition: background-color 0.2s, color 0.2s;
		margin: 0;
	}

	.sidebar-home-cta:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}

	.sidebar-home-cta svg {
		flex-shrink: 0;
		opacity: 0.8;
		width: 16px;
		height: 16px;
	}

	/* Links de la nav principal: solo en el drawer móvil,
	   en desktop ya están visibles en el header. */
	@media (min-width: 50rem) {
		.sidebar-nav-extra {
			display: none;
		}
	}
</style>
