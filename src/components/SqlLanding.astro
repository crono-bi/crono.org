---
// SQL Landing Page - Using the generic ManualLanding component
import ManualLanding from './ManualLanding.astro'
import type { Feature, Category, Statement, FuncExample } from './ManualLanding.astro'
import mergeCloneExample from '../playground/examples/merge-clone.sql?raw'
import { ENGINE_NAMES } from '../config/engines'
import { useT, getLangFromLocale } from '../i18n/ui'

const lang = getLangFromLocale(Astro.currentLocale)
const t = useT(lang)
const prefix = lang === 'en' ? '/en' : ''

const features: Feature[] = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>',
    title: t('sqlLanding.feature1.title'),
    description: t('sqlLanding.feature1.desc')
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16"/><path d="M4 15h16"/><path d="M10 3 8 21"/><path d="M14 3l-2 18"/></svg>',
    title: t('sqlLanding.feature2.title'),
    description: t('sqlLanding.feature2.desc')
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>',
    title: t('sqlLanding.feature3.title'),
    description: t('sqlLanding.feature3.desc')
  }
]

const categories: Category[] = [
  {
    id: 'language',
    title: t('sqlLanding.category.language.title'),
    description: t('sqlLanding.category.language.desc'),
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>',
    count: 24,
    path: `${prefix}/sql/language/`
  },
  {
    id: 'reference',
    title: t('sqlLanding.category.reference.title'),
    description: t('sqlLanding.category.reference.desc'),
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M12 11h5"/><path d="M12 7h5"/></svg>',
    count: 15,
    path: `${prefix}/sql/reference/`
  },
  {
    id: 'functions',
    title: t('sqlLanding.category.functions.title'),
    description: t('sqlLanding.category.functions.desc'),
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5h-2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="2"/><path d="m9 14 2 2 4-4"/></svg>',
    count: 40,
    path: `${prefix}/sql/functions/`
  },
  {
    id: 'views',
    title: t('sqlLanding.category.views.title'),
    description: t('sqlLanding.category.views.desc'),
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>',
    count: 12,
    path: `${prefix}/sql/views/`
  }
]

const engines = ENGINE_NAMES

const statements: Statement[] = [
  { name: 'SELECT', description: t('sqlLanding.stmt.select') },
  { name: 'MERGE CLONE', description: t('sqlLanding.stmt.mergeClone') },
  { name: 'MERGE UPSERT', description: t('sqlLanding.stmt.mergeUpsert') },
  { name: 'MERGE HISTORY', description: t('sqlLanding.stmt.mergeHistory') },
  { name: 'MERGE SOFT DELETE', description: t('sqlLanding.stmt.mergeSoftDelete') },
  { name: 'INSERT OVERWRITE', description: t('sqlLanding.stmt.insertOverwrite') },
  { name: 'INSERT IF NEW', description: t('sqlLanding.stmt.insertIfNew') },
  { name: 'CHECK SNOWFLAKE', description: t('sqlLanding.stmt.checkSnowflake') },
  { name: 'MATERIALIZE', description: t('sqlLanding.stmt.materialize') }
]

const functions: FuncExample[] = [
  { code: 'margin(a, b)', description: t('sqlLanding.fn.margin') },
  { code: 'markup(a, b)', description: t('sqlLanding.fn.markup') },
  { code: 'divide(a, b)', description: t('sqlLanding.fn.divide') },
  { code: 'substraction(a, b)', description: t('sqlLanding.fn.substraction') }
]

// Use the example from playground (single source of truth)
const codeExample = mergeCloneExample

// Process dynamically: remove comment, escape HTML, add color spans
function highlightForLanding(code: string): string {
  // Remove /* */ comment block
  const withoutComment = code.replace(/\/\*[\s\S]*?\*\//, '').trim()
  
  // Escape HTML special chars
  let escaped = withoutComment
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
  
  // Apply color spans to Crono SQL keywords
  const keywords = [
    'MERGE CLONE', 'INNER JOIN', 'SELECT', 'FROM', 'USING', 'KEY'
  ]
  
  for (const kw of keywords) {
    const regex = new RegExp(kw.replace(/\s+/g, '\\s+'), 'g')
    escaped = escaped.replace(regex, `<span class="ck">${kw}</span>`)
  }
  
  return escaped
}

const codeExampleDisplay = highlightForLanding(mergeCloneExample)

// Encode example code for playground URL
const playgroundUrl = `${prefix}/playground/?code=${btoa(encodeURIComponent(codeExample))}`
---

<ManualLanding
  logo="/logos/crono-sql.webp"
  logoAlt="Crono SQL"
  subtitle={t('sqlLanding.subtitle')}
  ctaText={t('sqlLanding.cta.manual')}
  ctaHref={`${prefix}/sql/intro/`}
  secondaryCta={{ text: t('sqlLanding.cta.playground'), href: playgroundUrl }}
  brandColor="#10B981"
  features={features}
  featuresTitle={t('sqlLanding.featuresTitle')}
  engines={engines}
  codeExample={{
    label: 'Crono SQL',
    code: codeExampleDisplay,
    language: 'html-pre'
  }}
  statements={statements}
  statementsTitle={t('sqlLanding.statementsTitle')}
  functions={functions}
  functionsTitle={t('sqlLanding.functionsTitle')}
  functionsDesc={t('sqlLanding.functionsDesc')}
  playgroundCta={{
    title: t('sqlLanding.playground.title'),
    description: t('sqlLanding.playground.desc'),
    buttonText: t('sqlLanding.playground.cta'),
    href: playgroundUrl
  }}
  footerTitle={t('sqlLanding.footer.title')}
  footerDesc={t('sqlLanding.footer.desc')}
  footerCta={t('sqlLanding.footer.cta')}
  footerSecondaryCta={{ text: t('sqlLanding.cta.playground'), href: playgroundUrl }}
/>
