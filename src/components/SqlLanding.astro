const engines = ['SQL Server', 'Snowflake', 'PostgreSQL', 'Redshift', 'BigQuery', 'Databricks', 'MS Fabric', 'DuckDB']

const statements: Statement[] = [
  { name: 'SELECT', description: 'JOINs simplificados, columnas reutilizables y apilamiento de consultas' },
  { name: 'MERGE CLONE', description: 'Sincronización completa: crea la tabla, la mantiene y gestiona la auditoría' },
  { name: 'MERGE UPSERT', description: 'Inserta los registros nuevos y actualiza los existentes (SCD Tipo 1)' },
  { name: 'MERGE HISTORY', description: 'Mantiene historial completo de cambios (SCD Tipo 2)' },
  { name: 'MERGE SOFT DELETE', description: 'Marca como eliminados los registros que ya no existen en origen' },
  { name: 'INSERT OVERWRITE', description: 'Recarga completa: elimina y vuelve a insertar todos los registros' },
  { name: 'INSERT IF NEW', description: 'Inserta solo los registros nuevos, sin modificar los existentes' },
  { name: 'CHECK SNOWFLAKE', description: 'Verifica que los JOINs no pierdan ni dupliquen registros' },
  { name: 'MATERIALIZE', description: 'Define tablas temporales para simplificar consultas complejas' }
]

const functions: FuncExample[] = [
  { code: 'margin(a, b)', description: 'Margen de ventas seguro' },
  { code: 'markup(a, b)', description: 'Márkup seguro' },
  { code: 'divide(a, b)', description: 'División segura (sin error /0)' },
  { code: 'substraction(a, b)', description: 'Resta segura' }
]

// Use the example from playground (single source of truth)
const codeExample = mergeCloneExample

// Process dynamically: remove comment, escape HTML, add color spans
function highlightForLanding(code: string): string {
  // Remove /* */ comment block
  const withoutComment = code.replace(/\/\*[\s\S]*?\*\//, '').trim()
  
  // Escape HTML special chars
  let escaped = withoutComment
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
  
  // Apply color spans to Crono SQL keywords
  const keywords = [
    'MERGE CLONE', 'INNER JOIN', 'SELECT', 'FROM', 'USING', 'KEY'
  ]
  
  for (const kw of keywords) {
    const regex = new RegExp(kw.replace(/\s+/g, '\\s+'), 'g')
    escaped = escaped.replace(regex, `<span class="ck">${kw}</span>`)
  }
  
  return escaped
}

const codeExampleDisplay = highlightForLanding(mergeCloneExample)

// Encode example code for playground URL
const playgroundUrl = `/playground/?code=${btoa(encodeURIComponent(codeExample))}`
---

<ManualLanding
  logo="/logos/crono-sql.webp"
  logoAlt="Crono SQL"
  subtitle="Escríbelo una vez. Cárgalo en cualquier motor."
  ctaText="Acceder al manual"
  ctaHref="/sql/intro/"
  secondaryCta={{ text: 'Playground', href: playgroundUrl }}
  brandColor="#10B981"
  features={features}
  featuresTitle="¿Qué es Crono SQL?"
  engines={engines}
  codeExample={{
    label: 'Crono SQL',
    code: codeExampleDisplay,
    language: 'html-pre'
  }}
  statements={statements}
  statementsTitle="Sentencias principales"
  functions={functions}
  functionsTitle="Funciones integradas"
  functionsDesc="Crono SQL soporta todas las funciones nativas de cada motor y añade sus propias funciones como:"
  playgroundCta={{
    title: 'Playground interactivo',
    description: 'Escribe Crono SQL y mira en tiempo real el SQL generado para cada motor de base de datos.',
    buttonText: 'Probar este ejemplo',
    href: playgroundUrl
  }}
  footerTitle="¿Listo para probar Crono SQL?"
  footerDesc="Explora la documentación completa y empieza a construir tu Data Warehouse."
  footerCta="Acceder al manual"
  footerSecondaryCta={{ text: 'Playground', href: playgroundUrl }}
/>
