---
import { ENGINES, ENGINE_BY_NAME, type Engine } from '../config/engines'

interface Props {
  // Opcional: lista de nombres a mostrar. Si se omite, muestra todos los motores.
  engines?: string[]
}

const { engines } = Astro.props

// Derivado de la fuente única (config/engines.ts)
const items: Engine[] = engines
  ? engines.map(name => ENGINE_BY_NAME.get(name)).filter((e): e is Engine => !!e)
  : ENGINES
---

<div class="engines-logos">
  {items.map((engine) => (
    <div class="engine-logo-item">
      <img src={engine.logo} alt={engine.name} class="engine-logo" />
      <span class="engine-name" style={`color: ${engine.color}`}>
        {engine.name}
      </span>
    </div>
  ))}
</div>

<style>
  .engines-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: flex-start;
    row-gap: 1.5rem;
    padding: 0.5rem 0;
  }

  .engine-logo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transition: transform 0.25s ease;
    cursor: default;
  }

  .engine-logo-item:hover {
    transform: translateY(-3px);
  }

  .engine-logo {
    height: 36px;
    width: auto;
    object-fit: contain;
    transition: transform 0.25s ease;
  }

  .engine-logo-item:hover .engine-logo {
    transform: scale(1.1);
  }

  .engine-name {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }

  .engine-chip {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    background: rgba(var(--brand-rgb-value, 27, 95, 140), 0.15);
    border: 1px solid rgba(var(--brand-rgb-value, 27, 95, 140), 0.3);
    color: var(--brand-color, var(--sl-color-accent));
  }
</style>
