---
// DownloadsLanding.astro - Wrapper Astro que hidrata la landing client-side.

import SupportBanner from './SupportBanner.astro'
import DownloadsLandingClient from './DownloadsLandingClient.vue'
import { getLangFromLocale, getLocalePrefix } from '../i18n/ui'

const prefix = getLocalePrefix(getLangFromLocale(Astro.currentLocale))
---

<div class="dl-landing-wrapper">
	<DownloadsLandingClient prefix={prefix} client:load />
</div>

<SupportBanner />

<style>
	.dl-landing-wrapper {
		min-height: 320px;
	}
</style>
