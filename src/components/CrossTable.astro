---
/**
 * CrossTable — tabla cruzada reusable para documentación.
 *
 * Props:
 *   columns     — cabeceras de columna: string[] o { label, group? }[]
 *   rows        — { label, cells: string[] }[]
 *   groups      — (opcional) array de { label, span } para cabeceras de grupo
 *   caption     — (opcional) texto de leyenda
 *   showLegend  — (default true) muestra la leyenda de colores
 *
 * Valores de celda:
 *   'yes'   → verde   (Obligatoria / Required)
 *   'no'    → texto "Opcional" (Optional)
 *   'nokey' → X roja  (Sin Key / No Key)
 *   'x'     → verde   (igual que 'yes')
 *   'dash'  → vacío
 *   ''      → vacío
 */
import { getLangFromLocale } from '../i18n/ui.ts'

interface Column {
  label: string
}

interface Row {
  label: string
  cells: string[]
}

interface Group {
  label: string
  span: number
}

interface Props {
  columns: string[] | Column[]
  rows: Row[]
  groups?: Group[]
  caption?: string
  showLegend?: boolean
}

const { columns, rows, groups, caption, showLegend = false } = Astro.props
const lang = getLangFromLocale(Astro.currentLocale)

const allLabels = columns.map(c => (typeof c === 'string' ? c : c.label))
const rowHeaderLabel = allLabels[0] ?? ''
const colLabels = allLabels.slice(1)

const CHECK  = `<svg class="ct-icon ct-icon--check" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`
const X_ICO = `<svg class="ct-icon ct-icon--x" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`

const CELL_ICON: Record<string, string> = {
  yes:   CHECK,
  x:     CHECK,
}

const CELL_TEXT: Record<string, Record<string, string>> = {
  es: { no: 'Opcional', nokey: 'No admite clave' },
  en: { no: 'Optional', nokey: 'Does not support key' },
}

// Screen-reader / LLM accessible labels for cell values
const SR_TEXT: Record<string, Record<string, string>> = {
  es: {
    yes: 'Obligatoria',
    x: 'Obligatoria',
    no: 'Opcional',
    nokey: 'Sin Key',
    dash: '',
    '': '',
  },
  en: {
    yes: 'Required',
    x: 'Required',
    no: 'Optional',
    nokey: 'No Key',
    dash: '',
    '': '',
  },
}

// Check if column is part of DATE group (for background highlighting)
// Supports both English (DATE) and Spanish (FECHA)
const isDateColumn = (colLabel: string): boolean => {
  const lower = colLabel.toLowerCase()
  return lower.includes('date') || lower.includes('fecha')
}

function ci(v: string, colLabel?: string): string {
  if (v === 'dash' || v === '') return ''
  if (v === 'no') return `<span class="ct-text-optional">${CELL_TEXT[lang]?.[v] || 'Opcional'}</span>`
  if (v === 'nokey') return `<span class="ct-text-nokey">${CELL_TEXT[lang]?.[v] || 'No admite clave'}</span>`
  return CELL_ICON[v] ?? v
}

function sr(v: string): string {
  return SR_TEXT[lang]?.[v] || ''
}
---

<div class="ct-wrap">
  <div class="ct-scroll">
    <table class="ct-table" role="grid">
      <thead>
        {groups && (
          <tr class="ct-group-row">
            <th class="ct-th ct-th--row-header ct-th--ghost" rowspan={2}></th>
            {groups.map(g => (
              <th class="ct-th ct-th--group" colspan={g.span}>{g.label}</th>
            ))}
          </tr>
        )}
        <tr>
          <th class="ct-th ct-th--row-header" set:html={rowHeaderLabel}></th>
          {colLabels.map((col) => (
            <th class="ct-th" set:html={col}></th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="ct-row">
            <td class="ct-td ct-td--row-header">
              <code class="ct-label">{row.label}</code>
            </td>
            {row.cells.map((cell, idx) => {
              const colLabel = colLabels[idx] || ''
              const hasBg = (cell === 'yes' || cell === 'x') && isDateColumn(colLabel)
              const srText = sr(cell)
              return (
                <td
                  class={`ct-td ct-cell--${cell || 'empty'}${hasBg ? ' ct-cell--highlight' : ''}`}
                  aria-label={srText || undefined}
                >
                  {cell && <span class="ct-val" set:html={ci(cell, colLabel)}></span>}
                  {srText && <span class="ct-sr-only">{srText}</span>}
                </td>
              )
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {caption && <p class="ct-caption">{caption}</p>}

</div>

<style>
  /* ── Wrapper ── */
  .ct-wrap {
    margin: 1.75rem 0;
    min-width: 0;
    contain: layout inline-size;
  }

  .ct-scroll {
    overflow-x: auto;
    max-width: 100%;
    border-radius: 8px;
    border: 1px solid var(--sl-color-hairline-light);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    /* Crear scroll container aislado para Chrome */
    -webkit-overflow-scrolling: touch;
    contain: layout;
  }

  /* ── Table ── */
  .ct-table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    min-width: 560px;
    font-size: 0.83rem;
    table-layout: auto;
    isolation: isolate;
  }

  /* ── Header ── */
  .ct-th {
    background: rgb(27, 95, 140);
    color: rgba(255,255,255,0.90);
    font-weight: 700;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.7rem 0.8rem;
    text-align: center;
    line-height: 1.4;
    border-right: 1px solid rgba(255,255,255,0.10);
    border-bottom: 2px solid rgba(0,0,0,0.12);
  }

  .ct-th:last-child { border-right: none; }

  .ct-th--row-header {
    text-align: left;
    min-width: 180px;
    padding-left: 1.1rem;
    letter-spacing: 0.04em;
    font-size: 0.72rem;
    text-transform: none;
    position: sticky;
    left: 0;
    z-index: 10;
    background: rgb(27, 95, 140);
  }

  .ct-th--ghost { background: rgba(27, 95, 140, 0.65); }

  .ct-th--group {
    background: rgba(27, 95, 140, 0.65);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
  }

  /* ── Rows ── */
  .ct-row { transition: background 0.12s ease; }
  .ct-row:last-child .ct-td { border-bottom: none; }

  .ct-row:hover .ct-td {
    background: rgba(27, 95, 140, 0.07) !important;
    transition: background 0.12s ease;
  }

  /* ── Cells ── */
  .ct-td {
    padding: 0.52rem 0.9rem;
    text-align: center;
    border-bottom: 1px solid var(--sl-color-hairline);
    border-right: 1px solid var(--sl-color-hairline);
    vertical-align: middle;
    height: 2.5rem;
    background: var(--sl-color-bg);
  }

  .ct-td:last-child { border-right: none; }

  .ct-td--row-header {
    text-align: left;
    padding-left: 1.1rem;
    white-space: nowrap;
    background: var(--sl-color-bg) !important;
    border-right: 2px solid rgba(27, 95, 140, 0.20);
    position: sticky;
    left: 0;
    z-index: 5;
  }

  .ct-row:hover .ct-td--row-header {
    background: var(--sl-color-bg) !important;
  }

  .ct-label {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--sl-color-white);
    background: none;
    border: none;
    padding: 0;
  }

  .ct-val {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .ct-icon {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
    flex-shrink: 0;
  }

  :global(.ct-text-optional) {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    letter-spacing: 0.01em;
  }

  :global(.ct-text-nokey) {
    font-size: 0.72rem;
    font-weight: 600;
    color: #dc2626 !important;
    letter-spacing: 0.01em;
  }

  /* Screen-reader / LLM accessible text (visually hidden) */
  .ct-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Highlight for DATE group columns with checkmark ── */
  .ct-cell--highlight {
    background: rgba(59, 130, 246, 0.20) !important;
  }

  /* ── Caption ── */
  .ct-caption {
    font-size: 0.73rem;
    color: var(--sl-color-gray-3);
    margin: 0.4rem 0 0;
    line-height: 1.5;
  }

  /* ── Legend (Minimal style) ── */
  .ct-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0;
    margin-top: 0.75rem;
    padding: 0;
    background: transparent;
    border: none;
    font-size: 0.78rem;
  }

  .ct-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-gray-3);
    padding: 0.2rem 0;
  }

  .ct-legend-item:not(:last-child)::after {
    content: '·';
    margin: 0 0.6rem;
    color: var(--sl-color-gray-5);
    font-weight: 700;
  }

  .ct-legend-icon {
    display: inline-flex;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .ct-legend-icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  .ct-legend-label {
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .ct-legend {
      gap: 0.4rem 0;
    }
    .ct-legend-item:not(:last-child)::after {
      margin: 0 0.4rem;
    }
  }
</style>
