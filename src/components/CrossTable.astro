---
/**
 * CrossTable — tabla cruzada reusable para documentación.
 *
 * Props:
 *   columns     — cabeceras de columna: string[] o { label, group? }[]
 *   rows        — { label, cells: string[] }[]
 *   groups      — (opcional) array de { label, span } para cabeceras de grupo
 *   caption     — (opcional) texto de leyenda
 *   showLegend  — (default true) muestra la leyenda de colores
 *
 * Valores de celda:
 *   'yes'   → verde   (Sí / Yes)
 *   'no'    → naranja (NO)
 *   'nokey' → amarillo (SIN KEY / NO KEY)
 *   'x'     → azul    (campo presente)
 *   'dash'  → gris    (sin campo de auditoría)
 *   ''      → vacío
 */
import { getLangFromLocale } from '../i18n/ui.ts'

interface Column {
  label: string
}

interface Row {
  label: string
  cells: string[]
}

interface Group {
  label: string
  span: number
}

interface Props {
  columns: string[] | Column[]
  rows: Row[]
  groups?: Group[]
  caption?: string
  showLegend?: boolean
}

const { columns, rows, groups, caption, showLegend = false } = Astro.props
const lang = getLangFromLocale(Astro.currentLocale)

const allLabels = columns.map(c => (typeof c === 'string' ? c : c.label))
const rowHeaderLabel = allLabels[0] ?? ''
const colLabels = allLabels.slice(1)

const CHECK  = `<svg class="ct-icon ct-icon--check" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`
const NO_ICO = `<svg class="ct-icon ct-icon--no" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`
const LOCK   = `<svg class="ct-icon ct-icon--lock" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V6a5 5 0 0 1 10 0v1"/></svg>`

const CELL_ICON: Record<string, string> = {
  yes:   CHECK,
  x:     CHECK,
  no:    NO_ICO,
  nokey: LOCK,
}

function ci(v: string): string {
  if (v === 'dash') return ''
  return CELL_ICON[v] ?? v
}
---

<div class="ct-wrap">
  <div class="ct-scroll">
    <table class="ct-table" role="grid">
      <thead>
        {groups && (
          <tr class="ct-group-row">
            <th class="ct-th ct-th--row-header ct-th--ghost" rowspan={2}></th>
            {groups.map(g => (
              <th class="ct-th ct-th--group" colspan={g.span}>{g.label}</th>
            ))}
          </tr>
        )}
        <tr>
          <th class="ct-th ct-th--row-header" set:html={rowHeaderLabel}></th>
          {colLabels.map((col) => (
            <th class="ct-th" set:html={col}></th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="ct-row">
            <td class="ct-td ct-td--row-header">
              <code class="ct-label">{row.label}</code>
            </td>
            {row.cells.map((cell) => (
              <td class={`ct-td ct-cell--${cell || 'empty'}`}>
                {cell && <span class="ct-val" set:html={ci(cell)}></span>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {caption && <p class="ct-caption">{caption}</p>}

  <!-- Leyenda -->
  <div class="ct-legend">
    <span class="ct-legend-item">
      <span class="ct-legend-icon" set:html={CHECK}></span>
      <span class="ct-legend-label">{lang === 'en' ? 'Yes / Present' : 'Sí / Presente'}</span>
    </span>
    <span class="ct-legend-item">
      <span class="ct-legend-icon" set:html={NO_ICO}></span>
      <span class="ct-legend-label">{lang === 'en' ? 'No' : 'No'}</span>
    </span>
    <span class="ct-legend-item">
      <span class="ct-legend-icon" set:html={LOCK}></span>
      <span class="ct-legend-label">{lang === 'en' ? 'No key required' : 'Sin key'}</span>
    </span>
  </div>
</div>

<style>
  /* ── Wrapper ── */
  .ct-wrap {
    margin: 1.75rem 0;
  }

  .ct-scroll {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--sl-color-hairline-light);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  /* ── Table ── */
  .ct-table {
    border-collapse: collapse;
    width: 100%;
    min-width: 560px;
    font-size: 0.83rem;
    table-layout: auto;
  }

  /* ── Header ── */
  .ct-th {
    background: rgb(27, 95, 140);
    color: rgba(255,255,255,0.90);
    font-weight: 700;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.7rem 0.8rem;
    text-align: center;
    line-height: 1.4;
    border-right: 1px solid rgba(255,255,255,0.10);
    border-bottom: 2px solid rgba(0,0,0,0.12);
  }

  .ct-th:last-child { border-right: none; }

  .ct-th--row-header {
    text-align: left;
    min-width: 180px;
    padding-left: 1.1rem;
    letter-spacing: 0.04em;
    font-size: 0.72rem;
    text-transform: none;
  }

  .ct-th--ghost { background: rgba(27, 95, 140, 0.65); }

  .ct-th--group {
    background: rgba(27, 95, 140, 0.65);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
  }

  /* ── Rows ── */
  .ct-row { transition: background 0.12s ease; }
  .ct-row:last-child .ct-td { border-bottom: none; }

  .ct-row:hover .ct-td {
    background: rgba(27, 95, 140, 0.07) !important;
    transition: background 0.12s ease;
  }

  /* ── Cells ── */
  .ct-td {
    padding: 0.52rem 0.9rem;
    text-align: center;
    border-bottom: 1px solid var(--sl-color-hairline);
    border-right: 1px solid var(--sl-color-hairline);
    vertical-align: middle;
    height: 2.5rem;
    background: var(--sl-color-bg);
  }

  .ct-td:last-child { border-right: none; }

  .ct-td--row-header {
    text-align: left;
    padding-left: 1.1rem;
    white-space: nowrap;
    background: rgba(27, 95, 140, 0.05) !important;
    border-right: 2px solid rgba(27, 95, 140, 0.20);
  }

  .ct-row:hover .ct-td--row-header {
    background: rgba(27, 95, 140, 0.10) !important;
  }

  .ct-label {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--sl-color-white);
    background: none;
    border: none;
    padding: 0;
  }

  .ct-val {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .ct-icon {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
    flex-shrink: 0;
  }

  /* ── Caption ── */
  .ct-caption {
    font-size: 0.73rem;
    color: var(--sl-color-gray-3);
    margin: 0.4rem 0 0;
    line-height: 1.5;
  }

  /* ── Legend (Minimal style) ── */
  .ct-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0;
    margin-top: 0.75rem;
    padding: 0;
    background: transparent;
    border: none;
    font-size: 0.78rem;
  }

  .ct-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-gray-3);
    padding: 0.2rem 0;
  }

  .ct-legend-item:not(:last-child)::after {
    content: '·';
    margin: 0 0.6rem;
    color: var(--sl-color-gray-5);
    font-weight: 700;
  }

  .ct-legend-icon {
    display: inline-flex;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .ct-legend-icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  .ct-legend-label {
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .ct-legend {
      gap: 0.4rem 0;
    }
    .ct-legend-item:not(:last-child)::after {
      margin: 0 0.4rem;
    }
  }
</style>
