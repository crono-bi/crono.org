---
// DownloadTable.astro - Wrapper Astro que hidrata la tabla client-side.
// El fetch real a updates.crono.net ahora ocurre en el navegador.

export interface Props {
	product: string;
	title?: string;
}

const { product, title } = Astro.props;

import DownloadTableClient from './DownloadTableClient.vue';
---

<DownloadTableClient product={product} title={title} client:load />
