---
// DownloadsAll - Vista completa con todos los productos y sidebar
import DownloadSummaryTable from './DownloadSummaryTable.astro'
import { getLangFromLocale, getLocalePrefix } from '../i18n/ui'

const lang = getLangFromLocale(Astro.currentLocale)
const prefix = getLocalePrefix(lang)

// Colores oficiales por producto
const COLORS = {
  analysis: '#C85A47',
  metadata: '#5B2C7D',
  etl: '#1B8AC7',
  downloads: '#2563EB',
  excel: '#1E7B47',
}

const productGroups = [
  {
    title: 'Productos principales',
    description: 'Los instaladores recomendados para la mayoría de entornos',
    items: [
      { name: 'Crono Analysis', desc: 'Herramienta de análisis y reporting', path: `${prefix}/downloads/crono-analysis/`, color: COLORS.analysis },
      { name: 'Crono Metadata', desc: 'Capa semántica y modelado', path: `${prefix}/downloads/crono-metadata/`, color: COLORS.metadata },
      { name: 'Crono ETL', desc: 'Extracción, transformación y carga', path: `${prefix}/downloads/crono-etl/`, color: COLORS.etl },
      { name: 'Crono Excel', desc: 'Informes en Excel', path: `${prefix}/downloads/crono-excel/`, color: COLORS.excel },
      { name: 'Crono Viewer', desc: 'Visualizador de informes', path: `${prefix}/downloads/crono-viewer/`, color: COLORS.analysis },
      { name: 'Crono Reporting', desc: 'Generación de informes', path: `${prefix}/downloads/crono-reporting/`, color: COLORS.analysis },
    ]
  },
  {
    title: 'Aplicaciones de servidor',
    description: 'Crono Administrator instala y administra Crono Server',
    items: [
      { name: 'Crono', desc: 'Producto base', path: `${prefix}/downloads/crono/`, color: COLORS.etl },
      { name: 'Crono Administrator', desc: 'Gestión de Crono Server', path: `${prefix}/downloads/crono-administrator/`, color: COLORS.etl },
      { name: 'Crono Jobs', desc: 'Servicio de tareas programadas', path: `${prefix}/downloads/crono-jobs/`, color: COLORS.etl },
      { name: 'Crono Server', desc: 'Infraestructura servidor', path: `${prefix}/downloads/crono-server/`, color: COLORS.etl },
    ]
  }
]

const specialGroups = [
  {
    title: 'Arquitectura x86 (32 bits)',
    description: 'Las aplicaciones de 32 bits son necesarias si no dispone de drivers de 64 bits para conectarse a sus orígenes de datos.',
    section: 'StandardReleaseX86' as const,
    items: [
      { name: 'Crono Analysis 32', path: `${prefix}/downloads/crono-analysis-32/`, color: COLORS.analysis },
      { name: 'Crono Metadata 32', path: `${prefix}/downloads/crono-metadata-32/`, color: COLORS.metadata },
      { name: 'Crono ETL 32', path: `${prefix}/downloads/crono-etl-32/`, color: COLORS.etl },
      { name: 'Crono Jobs 32', path: `${prefix}/downloads/crono-jobs-32/`, color: COLORS.etl },
    ]
  },
  {
    title: 'Packages MSI',
    description: 'No se recomienda el uso de estos instaladores MSI. Antes de utilizar estos paquetes consulte con su distribuidor.',
    section: 'MSIRelease' as const,
    items: [
      { name: 'Crono Analysis MSI', path: `${prefix}/downloads/crono-analysis-msi/`, color: COLORS.analysis },
      { name: 'Crono Metadata MSI', path: `${prefix}/downloads/crono-metadata-msi/`, color: COLORS.metadata },
      { name: 'Crono Administrator MSI', path: `${prefix}/downloads/crono-administrator-msi/`, color: COLORS.etl },
    ]
  },
  {
    title: 'Crono Classic',
    description: 'Esta es la última versión de la plataforma Crono vigente entre 2010 y 2015. Esta versión no tiene soporte y NO SE RECOMIENDA para proyectos nuevos.',
    section: 'CronoClassic' as const,
    items: [
      { name: 'Crono Classic', path: `${prefix}/downloads/crono-classic/`, color: '#6B7280' },
      { name: 'Crono Excel Classic', path: `${prefix}/downloads/crono-excel-classic/`, color: COLORS.excel },
    ]
  }
]

const downloadsColor = COLORS.downloads
const downloadsRgb = '37, 99, 235'
---

<div class="dl-all not-content" style={`--brand-color: ${downloadsColor}; --brand-rgb: ${downloadsRgb}`}>

  <!-- ═══ HEADER ═══ -->
  <div class="dl-all-header">
    <p>Lista completa de descargas disponibles de la plataforma Crono.</p>
    <a href={`${prefix}/downloads/`} class="dl-back-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Volver a Suite Crono
    </a>
  </div>

  <!-- ═══ DESCARGAS RECOMENDADAS ═══ -->
  <section class="dl-section">
    <div class="dl-section-header">
      <div class="dl-section-label">
        <div class="dl-section-line"></div>
        <span>Descargas recomendadas</span>
        <div class="dl-section-line"></div>
      </div>
      <p class="dl-section-desc">Los instaladores recomendados para la mayoría de entornos son los siguientes:</p>
    </div>
    <div class="dl-table-card">
      <DownloadSummaryTable section="StandardRelease" />
    </div>
  </section>

  <!-- ═══ SERVIDOR ═══ -->
  <section class="dl-section">
    <div class="dl-section-header">
      <div class="dl-section-label">
        <div class="dl-section-line"></div>
        <span>Aplicaciones de servidor</span>
        <div class="dl-section-line"></div>
      </div>
      <p class="dl-section-desc">Crono Administrator es la aplicación que instala y administra Crono Server.</p>
    </div>
    <div class="dl-table-card">
      <DownloadSummaryTable section="ServerRelease" />
    </div>
  </section>

  <!-- ═══ ESPECIALES ═══ -->
  {specialGroups.map(group => (
    <section class="dl-section dl-section--special">
      <div class="dl-special-header">
        <div class="dl-special-badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Avanzado
        </div>
        <h2 class="dl-special-title">{group.title}</h2>
        <p class="dl-special-desc">{group.description}</p>
      </div>
      <div class="dl-table-card">
        <DownloadSummaryTable section={group.section} />
      </div>
    </section>
  ))}

  <!-- ═══ REQUISITOS ═══ -->
  <section class="dl-section">
    <div class="dl-section-header">
      <div class="dl-section-label">
        <div class="dl-section-line"></div>
        <span>Requisitos del sistema</span>
        <div class="dl-section-line"></div>
      </div>
    </div>
    <div class="dl-req-grid">
      <div class="dl-req-card">
        <div class="dl-req-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
        </div>
        <h4>Sistema operativo</h4>
        <p>Windows 10 o superior<br/><span class="dl-req-note">(Windows 7 soportado en versiones Classic)</span></p>
      </div>
      <div class="dl-req-card">
        <div class="dl-req-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h4>Frameworks</h4>
        <p><a href="https://dotnet.microsoft.com/download">.NET 10</a> o superior<br/><a href="https://dotnet.microsoft.com/download/dotnet-framework">.NET Framework 4.7</a> <span class="dl-req-note">(solo Crono Excel)</span></p>
      </div>
      <div class="dl-req-card">
        <div class="dl-req-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 16.25"/><polyline points="16 21 12 17 8 21"/></svg>
        </div>
        <h4>Hardware mínimo</h4>
        <p>4GB RAM <span class="dl-req-note">(8GB recomendado)</span><br/>1GB espacio en disco</p>
      </div>
    </div>
  </section>


</div>

<style>
  /* ── BASE ── */
  .dl-all {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 0 4rem;
  }

  /* ── HEADER ── */
  .dl-all-header {
    text-align: center;
    padding: 2rem 0 2.5rem;
    margin-bottom: 2.5rem;
  }
  .dl-all-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 0.5rem;
  }
  .dl-all-header p {
    font-size: 1rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 1rem;
  }
  .dl-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--sl-color-accent);
    text-decoration: none;
    transition: gap 0.2s;
  }
  .dl-back-link:hover { gap: 0.6rem; }

  /* ── SECTIONS ── */
  .dl-section { margin-bottom: 3rem; }
  .dl-section-header { margin-bottom: 1.25rem; }

  .dl-section-label {
    display: flex; align-items: center; gap: 1rem;
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
  }
  .dl-section-line { flex: 1; height: 1px; background: var(--sl-color-hairline-light); }
  .dl-section-desc { font-size: 0.9rem; color: var(--sl-color-gray-3); margin: 0; }

  /* ── TABLE CONTAINER ── */
  .dl-table-card {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
  }

  /* ── PRODUCT GRID ── */
  .dl-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .dl-product-grid--small {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }

  /* ── PRODUCT CARD ── */
  .dl-product-card {
    position: relative;
    display: flex; flex-direction: column;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 14px; overflow: hidden;
    padding: 1.25rem;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .dl-product-card:hover {
    transform: translateY(-1px);
    border-color: var(--product-color);
    box-shadow: 0 6px 16px -6px rgba(0,0,0,0.25);
  }
  .dl-card-glow {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at 50% 0%, var(--product-color), transparent 60%);
    opacity: 0.04;
  }
  .dl-product-card:hover .dl-card-glow { opacity: 0.08; }

  .dl-card-top { margin-bottom: 0.875rem; }
  .dl-card-icon {
    width: 42px; height: 42px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
  }
  .dl-card-title {
    font-size: 1.0625rem; font-weight: 700; margin: 0 0 0.4rem;
    color: var(--sl-color-white);
  }
  .dl-card-desc {
    font-size: 0.875rem; color: var(--sl-color-gray-3);
    margin: 0 0 1rem; line-height: 1.5; flex: 1;
  }
  .dl-card-cta {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.8125rem; font-weight: 600;
    color: var(--product-color);
    transition: gap 0.2s;
  }
  .dl-product-card:hover .dl-card-cta { gap: 0.65rem; }
  .dl-card-border {
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 2px;
  }

  /* ── COMPACT CARD ── */
  .dl-product-card--compact {
    flex-direction: row; align-items: center;
    padding: 0.875rem 1rem; gap: 0.75rem;
  }
  .dl-card-icon-sm {
    width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .dl-card-title-sm {
    font-size: 0.9rem; font-weight: 600; color: var(--sl-color-white); flex: 1;
  }
  .dl-card-chevron { color: var(--sl-color-gray-3); flex-shrink: 0; }
  .dl-product-card--compact:hover .dl-card-chevron { color: var(--product-color); }

  /* ── SPECIAL SECTION ── */
  .dl-section--special {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 16px; padding: 1.5rem;
  }
  .dl-special-header { margin-bottom: 1.25rem; }
  .dl-special-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.25rem 0.75rem; border-radius: 999px;
    background: rgba(var(--brand-rgb), 0.08);
    border: 1px solid rgba(var(--brand-rgb), 0.2);
    color: var(--brand-color); font-size: 0.75rem; font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .dl-special-title { font-size: 1.125rem; font-weight: 700; margin: 0 0 0.5rem; color: var(--sl-color-white); }
  .dl-special-desc { font-size: 0.875rem; color: var(--sl-color-gray-3); margin: 0; }

  /* ── REQUIREMENTS ── */
  .dl-req-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .dl-req-card {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 14px; padding: 1.5rem;
    transition: border-color 0.2s;
  }
  .dl-req-card:hover { border-color: rgba(var(--brand-rgb), 0.4); }
  .dl-req-icon {
    width: 44px; height: 44px; border-radius: 12px; margin-bottom: 1rem;
    background: rgba(var(--brand-rgb), 0.1);
    color: var(--brand-color);
    display: flex; align-items: center; justify-content: center;
  }
  .dl-req-card h4 {
    font-size: 0.875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--sl-color-gray-2); margin: 0 0 0.625rem;
  }
  .dl-req-card p { font-size: 0.875rem; color: var(--sl-color-gray-3); margin: 0; line-height: 1.6; }
  .dl-req-note { font-size: 0.8125rem; color: var(--sl-color-gray-4); }
  .dl-req-card a { color: var(--brand-color); text-decoration: none; }
  .dl-req-card a:hover { text-decoration: underline; }

  /* ── TOOLS ── */
  .dl-tools-card {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
    background: linear-gradient(135deg, rgba(var(--brand-rgb), 0.06) 0%, rgba(var(--brand-rgb), 0.02) 100%);
    border: 1px solid rgba(var(--brand-rgb), 0.2);
    border-radius: 16px; padding: 1.5rem 2rem;
  }
  .dl-tools-content { display: flex; align-items: center; gap: 1rem; }
  .dl-tools-icon {
    width: 48px; height: 48px; border-radius: 12px; flex-shrink: 0;
    background: rgba(var(--brand-rgb), 0.12); color: var(--brand-color);
    display: flex; align-items: center; justify-content: center;
  }
  .dl-tools-title { font-size: 1rem; font-weight: 700; color: var(--sl-color-white); margin: 0 0 0.25rem; }
  .dl-tools-desc { font-size: 0.875rem; color: var(--sl-color-gray-3); margin: 0; }
  .dl-tools-cta {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.625rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600;
    background: var(--brand-color); color: white; text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    white-space: nowrap;
  }
  .dl-tools-cta:hover { opacity: 0.88; transform: translateY(-1px); }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    .dl-product-grid--small { grid-template-columns: 1fr; }
    .dl-tools-card { flex-direction: column; align-items: flex-start; }
  }
</style>
