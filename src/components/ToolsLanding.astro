---
const toolGroups = [
  {
    title: 'Bases de datos',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>',
    color: '#1B8AC7',
    tools: [
      { name: 'SQL Server Management Studio', abbr: 'SSMS', desc: 'Gestión y administración de SQL Server', href: 'https://docs.microsoft.com/sql/ssms/download-sql-server-management-studio-ssms', badge: 'Microsoft' },
      { name: 'Azure Data Studio', abbr: 'ADS', desc: 'IDE de datos moderno para SQL Server y Azure', href: 'https://docs.microsoft.com/sql/azure-data-studio/download', badge: 'Microsoft' },
      { name: 'pgAdmin', abbr: 'PGA', desc: 'Administración y desarrollo para PostgreSQL', href: 'https://www.pgadmin.org/download/', badge: 'PostgreSQL' },
      { name: 'DBeaver', abbr: 'DB', desc: 'Cliente de base de datos universal multiplataforma', href: 'https://dbeaver.io/download/', badge: 'Open Source' },
    ]
  },
  {
    title: 'Herramientas de desarrollo',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>',
    color: '#10B981',
    tools: [
      { name: 'Visual Studio Code', abbr: 'VS', desc: 'Editor de código ligero y extensible', href: 'https://code.visualstudio.com/download', badge: 'Microsoft' },
      { name: 'Visual Studio 2022', abbr: 'VS', desc: 'IDE completo para desarrollo .NET', href: 'https://visualstudio.microsoft.com/downloads/', badge: 'Microsoft' },
      { name: 'Git', abbr: 'GIT', desc: 'Sistema de control de versiones distribuido', href: 'https://git-scm.com/downloads', badge: 'Open Source' },
    ]
  },
  {
    title: 'Utilidades',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
    color: '#C85A47',
    tools: [
      { name: 'Postman', abbr: 'PM', desc: 'Testing y documentación de APIs REST', href: 'https://www.postman.com/downloads/', badge: 'Testing' },
      { name: 'WinSCP', abbr: 'WS', desc: 'Transferencia segura de archivos SFTP/FTP', href: 'https://winscp.net/eng/download.php', badge: 'Open Source' },
      { name: 'PuTTY', abbr: 'PT', desc: 'Cliente SSH y Telnet para conexión remota', href: 'https://www.putty.org/', badge: 'Open Source' },
    ]
  }
]

const requirements = [
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>',
    title: 'Sistema operativo',
    value: 'Windows 10 o superior',
    note: 'Windows 7 soportado en versiones Classic'
  },
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
    title: '.NET Runtime',
    value: '.NET 6 o superior',
    href: 'https://dotnet.microsoft.com/download',
    note: 'Requerido por todos los productos Crono'
  },
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
    title: '.NET Framework',
    value: '.NET Framework 4.7+',
    href: 'https://dotnet.microsoft.com/download/dotnet-framework',
    note: 'Solo para Crono Excel'
  },
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 16.25"/><polyline points="16 21 12 17 8 21"/></svg>',
    title: 'Actualizaciones',
    value: 'Windows Update activo',
    note: 'Mantén el sistema actualizado regularmente'
  },
]
---

<div class="tools-landing not-content">

  <!-- HERO -->
  <section class="tl-hero">
    <div class="tl-hero-bg"></div>
    <div class="tl-hero-inner">
      <div class="tl-hero-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        Descargas · Crono
      </div>
      <h1 class="tl-hero-title">Herramientas de terceros</h1>
      <p class="tl-hero-desc">Software recomendado para desarrolladores y administradores que trabajan con la plataforma Crono.</p>
    </div>
  </section>

  <!-- REQUISITOS -->
  <section class="tl-section">
    <div class="tl-section-label">
      <div class="tl-line"></div><span>Requisitos del sistema</span><div class="tl-line"></div>
    </div>
    <div class="tl-req-grid">
      {requirements.map(req => (
        <div class="tl-req-card">
          <div class="tl-req-icon" set:html={req.icon}></div>
          <div class="tl-req-body">
            <span class="tl-req-title">{req.title}</span>
            {req.href
              ? <a href={req.href} class="tl-req-value" target="_blank" rel="noopener">{req.value}</a>
              : <span class="tl-req-value">{req.value}</span>
            }
            <span class="tl-req-note">{req.note}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- TOOL GROUPS -->
  {toolGroups.map(group => (
    <section class="tl-section">
      <div class="tl-section-label">
        <div class="tl-line"></div>
        <span class="tl-group-title-wrap">
          <span class="tl-group-icon" style={`background:${group.color}18; color:${group.color}`} set:html={group.icon}></span>
          {group.title}
        </span>
        <div class="tl-line"></div>
      </div>
      <div class="tl-tools-grid">
        {group.tools.map(tool => (
          <a href={tool.href} target="_blank" rel="noopener noreferrer" class="tl-tool-card" style={`--tc: ${group.color}`}>
            <div class="tl-tool-top">
              <div class="tl-tool-abbr" style={`background:${group.color}18; color:${group.color}`}>{tool.abbr}</div>
              <span class="tl-tool-badge">{tool.badge}</span>
            </div>
            <h3 class="tl-tool-name">{tool.name}</h3>
            <p class="tl-tool-desc">{tool.desc}</p>
            <span class="tl-tool-link">
              Descargar
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </span>
            <div class="tl-tool-border" style={`background:${group.color}`}></div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <!-- NOTAS -->
  <section class="tl-section">
    <div class="tl-notes-card">
      <div class="tl-notes-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <div class="tl-notes-body">
        <h3 class="tl-notes-title">Recomendaciones</h3>
        <ul class="tl-notes-list">
          <li>Instala las <strong>actualizaciones de Windows</strong> de manera regular</li>
          <li>Mantén los <strong>drivers de base de datos</strong> actualizados</li>
          <li>Para entornos corporativos, consulta con tu departamento de <strong>TI</strong> antes de instalar software adicional</li>
        </ul>
      </div>
    </div>
  </section>

</div>

<style>
  .tools-landing { max-width: 1000px; margin: 0 auto; padding: 0 1.5rem 4rem; }

  /* HERO */
  .tl-hero { position: relative; text-align: center; padding: 3.5rem 1rem 2.5rem; margin-bottom: 2.5rem; overflow: hidden; }
  .tl-hero-bg {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(107,114,128,0.1) 0%, transparent 70%);
    border-bottom: 1px solid rgba(107,114,128,0.1);
  }
  .tl-hero-inner { position: relative; z-index: 1; }
  .tl-hero-label {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 0.875rem; border-radius: 999px;
    background: rgba(107,114,128,0.1); border: 1px solid rgba(107,114,128,0.2);
    color: var(--sl-color-gray-3); font-size: 0.8rem; font-weight: 500; margin-bottom: 1.25rem;
  }
  .tl-hero-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.02em; color: var(--sl-color-white); margin: 0 0 0.875rem; }
  .tl-hero-desc { font-size: 1rem; color: var(--sl-color-gray-3); max-width: 520px; margin: 0 auto; line-height: 1.7; }

  /* SECTIONS */
  .tl-section { margin-bottom: 3rem; }
  .tl-section-label {
    display: flex; align-items: center; gap: 1rem;
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--sl-color-gray-3); margin-bottom: 1.25rem;
  }
  .tl-line { flex: 1; height: 1px; background: var(--sl-color-hairline-light); }
  .tl-group-title-wrap { display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; }
  .tl-group-icon { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

  /* REQUIREMENTS */
  .tl-req-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .tl-req-card {
    display: flex; align-items: flex-start; gap: 0.875rem;
    background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline-light);
    border-radius: 12px; padding: 1.125rem;
    transition: border-color 0.2s;
  }
  .tl-req-card:hover { border-color: rgba(37,99,235,0.35); }
  .tl-req-icon {
    width: 36px; height: 36px; border-radius: 9px; flex-shrink: 0;
    background: rgba(37,99,235,0.1); color: #3B82F6;
    display: flex; align-items: center; justify-content: center;
  }
  .tl-req-body { display: flex; flex-direction: column; gap: 0.15rem; }
  .tl-req-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3); }
  .tl-req-value { font-size: 0.9rem; font-weight: 600; color: var(--sl-color-white); text-decoration: none; }
  a.tl-req-value:hover { color: #3B82F6; }
  .tl-req-note { font-size: 0.775rem; color: var(--sl-color-gray-4, #9ca3af); line-height: 1.4; }

  /* TOOLS GRID */
  .tl-tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .tl-tool-card {
    position: relative; display: flex; flex-direction: column;
    background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline-light);
    border-radius: 14px; overflow: hidden; padding: 1.25rem;
    text-decoration: none; transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .tl-tool-card:hover {
    transform: translateY(-3px); border-color: var(--tc);
    box-shadow: 0 10px 28px -8px rgba(0,0,0,0.25);
  }
  .tl-tool-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.875rem; }
  .tl-tool-abbr {
    width: 38px; height: 38px; border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.65rem; font-weight: 800; letter-spacing: 0.03em;
  }
  .tl-tool-badge {
    font-size: 0.7rem; font-weight: 600; padding: 0.2rem 0.55rem;
    border-radius: 999px; background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-gray-3); border: 1px solid var(--sl-color-hairline-light);
  }
  .tl-tool-name { font-size: 0.9375rem; font-weight: 700; color: var(--sl-color-white); margin: 0 0 0.375rem; }
  .tl-tool-desc { font-size: 0.8125rem; color: var(--sl-color-gray-3); margin: 0 0 1rem; line-height: 1.5; flex: 1; }
  .tl-tool-link {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.8rem; font-weight: 600; color: var(--tc);
    transition: gap 0.2s;
  }
  .tl-tool-card:hover .tl-tool-link { gap: 0.55rem; }
  .tl-tool-border { position: absolute; bottom: 0; left: 0; right: 0; height: 2px; }

  /* NOTES */
  .tl-notes-card {
    display: flex; gap: 1.25rem; align-items: flex-start;
    background: rgba(37,99,235,0.04); border: 1px solid rgba(37,99,235,0.15);
    border-radius: 14px; padding: 1.5rem;
  }
  .tl-notes-icon {
    width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
    background: rgba(37,99,235,0.1); color: #3B82F6;
    display: flex; align-items: center; justify-content: center;
  }
  .tl-notes-title { font-size: 1rem; font-weight: 700; color: var(--sl-color-white); margin: 0 0 0.75rem; }
  .tl-notes-list { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .tl-notes-list li { font-size: 0.9rem; color: var(--sl-color-gray-3); line-height: 1.6; }
  .tl-notes-list strong { color: var(--sl-color-gray-2); }

  @media (max-width: 640px) {
    .tl-tools-grid, .tl-req-grid { grid-template-columns: 1fr 1fr; }
    .tl-notes-card { flex-direction: column; }
  }
  @media (max-width: 400px) {
    .tl-tools-grid, .tl-req-grid { grid-template-columns: 1fr; }
  }
</style>
