---
// DownloadSummaryTable.astro - Tabla resumen con últimas versiones
// Reemplazo de DownloadAllTable.js (Docusaurus/React) a Astro

export interface Props {
	section?: 'StandardRelease' | 'ServerRelease' | 'StandardReleaseX86' | 'MSIRelease' | 'CronoClassic';
	title?: string;
}

const { section = 'StandardRelease', title } = Astro.props;

// Definición de releases por sección (igual que en el origin)
const releaseSections: Record<string, string[]> = {
	StandardRelease: ["CronoAnalysis", "CronoMetadata", "CronoETL", "CronoViewer", "CronoExcelMSI", "CronoReporting"],
	ServerRelease: ["Crono", "CronoJobs", "CronoAdministrator", "CronoServer"],
	StandardReleaseX86: ["CronoAnalysis32", "CronoMetadata32", "CronoETL32", "CronoJobs32"],
	MSIRelease: ["CronoAnalysisMSI", "CronoMetadataMSI", "CronoAdministratorMSI"],
	CronoClassic: ["CronoClassicMSI", "CronoExcelClassicMSI"],
};

// Mapeo de nombres de producto a URLs slug correctas
const productSlugMap: Record<string, string> = {
	Crono: 'crono',
	CronoAnalysis: 'crono-analysis',
	CronoMetadata: 'crono-metadata',
	CronoETL: 'crono-etl',
	CronoServer: 'crono-server',
	CronoJobs: 'crono-jobs',
	CronoAdministrator: 'crono-administrator',
	CronoViewer: 'crono-viewer',
	CronoReporting: 'crono-reporting',
	CronoExcelMSI: 'crono-excel',
	CronoAnalysis32: 'crono-analysis-32',
	CronoMetadata32: 'crono-metadata-32',
	CronoETL32: 'crono-etl-32',
	CronoJobs32: 'crono-jobs-32',
	CronoAnalysisMSI: 'crono-analysis-msi',
	CronoMetadataMSI: 'crono-metadata-msi',
	CronoAdministratorMSI: 'crono-administrator-msi',
	CronoClassicMSI: 'crono-classic',
	CronoExcelClassicMSI: 'crono-excel-classic',
};

const getProductColor = (releaseName: string): string => {
	const mapping: Record<string, string> = {
		CronoAnalysis:        '#C85A47',
		CronoAnalysis32:      '#C85A47',
		CronoAnalysisMSI:     '#C85A47',
		CronoViewer:          '#C85A47',
		CronoReporting:       '#C85A47',
		CronoMetadata:        '#5B2C7D',
		CronoMetadata32:      '#5B2C7D',
		CronoMetadataMSI:     '#5B2C7D',
		CronoETL:             '#1B8AC7',
		CronoETL32:           '#1B8AC7',
		CronoServer:          '#1B8AC7',
		Crono:                '#1B8AC7',
		CronoJobs:            '#1B8AC7',
		CronoJobs32:          '#1B8AC7',
		CronoAdministrator:   '#1B8AC7',
		CronoAdministratorMSI:'#1B8AC7',
		CronoExcel:           '#1E7B47',
		CronoExcelMSI:        '#1E7B47',
		CronoClassicMSI:      '#6B7280',
		CronoExcelClassicMSI: '#1E7B47',
	};
	return mapping[releaseName] || '#6B7280';
};

const formatDate = (dateStr: string): string => {
	if (!dateStr) return '';
	const date = new Date(dateStr);
	if (date.getFullYear() === 1) return '';
	
	const months = ['ene.', 'feb.', 'mar.', 'abr.', 'may.', 'jun.', 'jul.', 'ago.', 'sep.', 'oct.', 'nov.', 'dic.'];
	return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
};

// Fetch de datos en SSR
let items: any[] = [];
let error: string | null = null;

try {
	const response = await fetch('https://updates.crono.net/last.json');
	if (response.ok) {
		const allData = await response.json();
		const releaseNames = releaseSections[section] || [];
		
		// Filtrar solo los releases solicitados
		items = releaseNames
			.map(name => allData.find((p: any) => p.ReleaseName === name))
			.filter(Boolean);
	} else {
		error = 'No se pudo cargar la información';
	}
} catch (e) {
	error = 'Error al conectar con el servidor de actualizaciones';
}
---

<div class="download-table-container not-content">
	{title && <h3>{title}</h3>}
	
	{error ? (
		<div class="error-message">
			<p>{error}</p>
		</div>
	) : items.length === 0 ? (
		<div class="loading-message">
			<p>Cargando...</p>
		</div>
	) : (
		<div class="table-wrapper">
			<table class="download-table" style="table-layout: fixed; width: 100%">
				<colgroup>
					<col style="width: auto" />
					<col style="width: 7rem" />
					<col style="width: 9rem" />
					<col style="width: 8rem" />
					<col style="width: 7rem" />
				</colgroup>
				<thead>
					<tr>
						<th>Producto</th>
						<th>Versión</th>
						<th>Fecha</th>
						<th></th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{items.map((item) => (
						<tr>
							<td class="product-cell">{item.ProductDescription}</td>
							<td class="version-cell">{item.Version}</td>
							<td class="date-cell">{formatDate(item.Date)}</td>
							<td class="action-cell">
								{item.SetupUri && (
									<a 
										href={item.SetupUri}
										class="download-btn"
										target="_blank"
										rel="noopener noreferrer"
										title="Descargar instalador"
										style={`--btn-color: ${getProductColor(item.ReleaseName)}`}>
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
											<polyline points="7 10 12 15 17 10"/>
											<line x1="12" y1="15" x2="12" y2="3"/>
										</svg>
										Descargar
									</a>
								)}
							</td>
							<td class="link-cell">
								<a
									href={`/downloads/${productSlugMap[item.ReleaseName] || item.ReleaseName.toLowerCase()}`}
									class="versions-btn"
									title="Ver historial completo de versiones"
									style={`--btn-color: ${getProductColor(item.ReleaseName)}`}
								>
									<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 8v4l3 3"/>
										<circle cx="12" cy="12" r="10"/>
									</svg>
									Historial
								</a>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	)}
</div>

<style>
	.download-table-container.not-content {
		margin: 0;
	}

	.table-wrapper {
		overflow-x: auto;
		border-radius: 10px;
		background: var(--sl-color-bg-nav);
	}

	.download-table thead th:first-child {
		border-top-left-radius: 10px;
	}

	.download-table thead th:last-child {
		border-top-right-radius: 10px;
	}

	.download-table tbody tr:last-child td:first-child {
		border-bottom-left-radius: 10px;
	}

	.download-table tbody tr:last-child td:last-child {
		border-bottom-right-radius: 10px;
	}

	.download-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
		background: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 10px;
		overflow: hidden;
	}

	.download-table-container.not-content .download-table thead,
	.download-table-container.not-content .download-table thead th {
		background: var(--sl-color-accent, #2563EB);
		color: white !important;
	}

	.download-table thead th {
		padding: 0.75rem 1rem;
		text-align: left;
		font-weight: 600;
		white-space: nowrap;
	}

	.download-table tbody tr {
		border-bottom: 1px solid var(--sl-color-hairline-light);
		transition: background-color 0.15s;
	}

	.download-table tbody tr:last-child {
		border-bottom: none;
	}

	.download-table tbody tr:nth-child(even) {
		background-color: rgba(128, 128, 128, 0.04);
	}

	.download-table tbody tr:hover {
		background-color: rgba(128, 128, 128, 0.08);
	}

	.download-table-container.not-content .download-table tbody td {
		padding: 0.75rem 1rem;
		color: var(--sl-color-gray-2) !important;
	}

	.product-cell {
		font-weight: 500;
	}

	.version-cell {
		font-family: ui-monospace, monospace;
		font-size: 0.8125rem;
	}

	.date-cell {
		white-space: nowrap;
		color: var(--sl-color-gray-3);
	}

	.action-cell {
		text-align: center;
	}

	.link-cell {
		text-align: right;
	}

	.download-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 100%;
		padding: 0.375rem 0.625rem;
		background: color-mix(in srgb, var(--btn-color) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--btn-color) 30%, transparent);
		border-radius: 0.375rem;
		color: var(--btn-color);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.15s;
		white-space: nowrap;
	}

	.download-btn:hover {
		background: var(--btn-color);
		border-color: var(--btn-color);
		color: white;
	}

	.versions-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		width: 100%;
		padding: 0.375rem 0.625rem;
		background: transparent;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.375rem;
		color: var(--sl-color-gray-2);
		font-size: 0.8125rem;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.15s;
		white-space: nowrap;
	}

	.versions-btn:hover {
		background: color-mix(in srgb, var(--btn-color) 12%, transparent);
		border-color: color-mix(in srgb, var(--btn-color) 40%, transparent);
		color: var(--btn-color);
	}

	.error-message,
	.loading-message {
		padding: 2rem;
		text-align: center;
		color: var(--sl-color-gray-3);
		background: var(--sl-color-bg-sidebar);
		border-radius: 8px;
	}

	.error-message {
		color: var(--sl-color-red-high);
		background: var(--sl-color-red-low);
	}
</style>
