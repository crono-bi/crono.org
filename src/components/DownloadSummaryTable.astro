---
// DownloadSummaryTable.astro - Wrapper Astro que hidrata el resumen client-side.

import { getLangFromLocale, getLocalePrefix } from '../i18n/ui'
import DownloadSummaryTableClient from './DownloadSummaryTableClient.vue';

export interface Props {
	section?: 'StandardRelease' | 'ServerRelease' | 'StandardReleaseX86' | 'MSIRelease' | 'CronoClassic';
	title?: string;
}

const { section = 'StandardRelease', title } = Astro.props;
const prefix = getLocalePrefix(getLangFromLocale(Astro.currentLocale))
---

<DownloadSummaryTableClient section={section} title={title} prefix={prefix} client:load />
