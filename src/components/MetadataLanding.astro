---
// Metadata Landing Page - With SectionIndex for all pages
import ManualLanding from './ManualLanding.astro'
import type { Feature } from './ManualLanding.astro'
import { useT, getLangFromLocale } from '../i18n/ui'

const t = useT(getLangFromLocale(Astro.currentLocale))

const features: Feature[] = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>',
    title: t('metadataLanding.feature1.title'),
    description: t('metadataLanding.feature1.desc')
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/><path d="m15 5 3 3"/></svg>',
    title: t('metadataLanding.feature2.title'),
    description: t('metadataLanding.feature2.desc')
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m14.31 8 5.74 9.94"/><path d="M9.69 8h11.48"/><path d="m7.38 12 5.74-9.94"/><path d="M9.69 16 3.95 6.06"/><path d="M14.31 16H2.83"/><path d="m16.62 12-5.74 9.94"/></svg>',
    title: t('metadataLanding.feature3.title'),
    description: t('metadataLanding.feature3.desc')
  }
]
---

<ManualLanding
  logo="/logos/crono-metadata.webp"
  logoAlt="Crono Metadata"
  subtitle={t('metadataLanding.subtitle')}
  ctaText={t('metadataLanding.cta.manual')}
  ctaHref="/metadata/intro/"
  brandColor="#5B2C7D"
  features={features}
  featuresTitle={t('metadataLanding.featuresTitle')}
  basePath="/metadata/"
  basePathTitle={t('metadataLanding.basePathTitle')}
  footerTitle={t('metadataLanding.footer.title')}
  footerDesc={t('metadataLanding.footer.desc')}
  footerCta={t('metadataLanding.footer.cta')}
/>
